# LLM API (OpenAI or compatible)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Email SMTP (for delivery plugin)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=...
SMTP_FROM=insight@example.com
EMAIL_TO=user1@email.com,user2@email.com

# Semantic Scholar API (optional - for higher rate limits)
# Get API key from: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=...

# Slack Webhook (optional - for Slack notifications)
# Create webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord Webhook (optional - for Discord notifications)
# Create webhook in Discord server settings -> Integrations
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/TOKEN
